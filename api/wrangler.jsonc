{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "la-comarca-formularios",
  "main": "worker.mjs",
  "account_id": "0b4dd54f3b1974a7036afdf876164aa2",
  "compatibility_date": "2026-09-13",
