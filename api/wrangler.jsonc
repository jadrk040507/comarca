    "NOTION_DATA_SOURCE_ID": "3d479aad-5d83-8055-a2d6-000b045a7d89"
  },
  "ratelimits": [
    {
      "name": "FORM_LIMIT",
      "namespace_id": "1047",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}
